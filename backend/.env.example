# ============================================================
# FACTOR PRO - Backend environment variables
# Copy this file to ".env" and adjust the values.
# NEVER commit the real .env file.
# ============================================================

FLASK_ENV=development
FLASK_APP=wsgi.py

# Application secrets (generate strong random values in production)
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too-in-production

# Database
# Development (SQLite):
DATABASE_URL=sqlite:///instance/factorpro.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://factorpro:strong_password@localhost:5432/factorpro

# Token lifetime (minutes)
JWT_ACCESS_TOKEN_MINUTES=120
JWT_REFRESH_TOKEN_DAYS=7

# Uploads (attachments) - path relative to the backend folder or absolute
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=10

# The application name and logo are configured in Settings (UI), not in this file.
# The uploaded logo is stored in UPLOAD_FOLDER and reused as the app icon, favicon,
# PWA manifest and company mark on every PDF/XLSX/receipt/duplicata.

# Initial administrator created by "flask seed"
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@factorpro.com.br
ADMIN_PASSWORD=Admin@12345

# When true, the forgot-password endpoint returns the reset token in the response
# (development only - an e-mail provider must be configured in production).
EXPOSE_RESET_TOKEN=true

# Public URL used to build the password recovery link
FRONTEND_BASE_URL=http://127.0.0.1:5000

# Transactional e-mail (password recovery AND loan-report sharing). Required in
# production. When MAIL_SERVER is empty, the loan report still returns the
# editable text for review and informs that no e-mail was sent.
# Example with a TLS SMTP provider:
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=no-reply@example.com
# MAIL_PASSWORD=change-me
# MAIL_DEFAULT_SENDER=FACTOR PRO <no-reply@example.com>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=FACTOR PRO <no-reply@factorpro.com.br>
MAIL_TIMEOUT_SECONDS=10

# Optional shared login throttling across multiple instances (production).
# Leave empty to use the in-memory fallback.
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URL=

# Daily safety backup. The enable switch, time and retention are configured in
# Settings (UI); the variables below only control the built-in scheduler and
# where the ZIP files are stored (inside instance/ by default, never versioned).
BACKUP_FOLDER=instance/backups
BACKUP_SCHEDULER_ENABLED=true
BACKUP_CHECK_INTERVAL_SECONDS=60
# Used only when the database is PostgreSQL:
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PG_DUMP_TIMEOUT_SECONDS=120
