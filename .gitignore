# ============================================================
# FACTOR PRO - arquivos que NÃO devem ser versionados
# ============================================================

# --- Python / Flask -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# --- Ambiente / segredos ------------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- Banco e anexos (dados de execução) ---------------------------------------
backend/instance/
*.db
*.sqlite
*.sqlite3
backend/instance/uploads/

# --- Node / frontend ----------------------------------------------------------
node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Scripts de verificação (saídas geradas) ----------------------------------
scripts/screenshots/
scripts/smoke-output.txt
scripts/flows-output.txt
scripts/verify-output.txt

# --- Logs locais ---------------------------------------------------------------
logs/

# --- Editores / SO ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
